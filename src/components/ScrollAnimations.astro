---
// Shared scroll-reveal behavior: any element marked data-reveal starts at
// opacity-0/translate-y-8 (set directly on the element's own class list) and
// gets those classes swapped for opacity-100/translate-y-0 the first time it
// scrolls into view. One observer for the whole page rather than each
// component wiring its own.
---

<script>
  const revealEls = document.querySelectorAll("[data-reveal]");

  if (revealEls.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-8");
            entry.target.classList.add("opacity-100", "translate-y-0");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
    );

    revealEls.forEach((el) => observer.observe(el));
  }
</script>
