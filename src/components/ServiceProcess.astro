---
interface ProcessStep {
  title: string;
  description: string;
}

interface Props {
  items: ProcessStep[];
}

const { items } = Astro.props;
---

<div class="relative mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
  <div
    data-reveal
    class="pointer-events-none absolute inset-x-0 top-6 hidden h-px origin-left scale-x-0 bg-gradient-to-r from-brand-red via-brand-blue to-brand-blue-light opacity-0 transition-all duration-1000 ease-out lg:block"
  >
  </div>
  {
    items.map((step, i) => (
      <div data-reveal style={`transition-delay: ${i * 150}ms`} class="group relative translate-y-8 scale-75 opacity-0 transition-all duration-500 ease-out">
        <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-brand-red to-[#a3121c] text-base font-bold text-white shadow-lg shadow-black/20 transition-transform duration-300 group-hover:scale-110">
          {String(i + 1).padStart(2, "0")}
        </div>
        <h3 class="mt-4 font-sans text-lg font-bold text-navy">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-navy/60">{step.description}</p>
      </div>
    ))
  }
</div>
