---
// Horizontal slider version of ServiceSubItems' icon-card (same icon badge,
// red hover, link-icon affordance) for a sub-service page's "other services
// under this parent" section — reuses RelatedServiceCards.astro's exact
// overflow-aware scroll mechanic (nav only shows once the track genuinely
// overflows, buttons disable at each edge) rather than inventing a new one.
interface SiblingItem {
  id: string;
  label: string;
  description: string;
  icon: string;
  href: string;
}

interface Props {
  items: SiblingItem[];
}

const { items } = Astro.props;
---

<div class="relative mt-10">
  <div id="sibling-track" class="sibling-track flex snap-x snap-mandatory gap-5 overflow-x-auto">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="group relative w-72 flex-none snap-start overflow-hidden rounded-2xl border border-slate-100 bg-white p-6 shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/20 hover:shadow-[0_25px_60px_-15px_rgba(18,85,127,0.35)] sm:w-80"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-blue to-brand-blue-light text-white shadow-md shadow-brand-blue/25 transition-all duration-300 group-hover:from-brand-red group-hover:to-[#a3121c] group-hover:shadow-brand-red/25">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={item.icon} />
          </span>
          <h3 class="mt-4 font-sans text-lg font-bold text-navy">{item.label}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy/60">{item.description}</p>
        </a>
      ))
    }
  </div>

  <div id="sibling-nav" class="mt-6 hidden justify-end gap-3">
    <button id="sibling-prev" type="button" aria-label="Previous service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white disabled:pointer-events-none disabled:opacity-30">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="sibling-next" type="button" aria-label="Next service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white disabled:pointer-events-none disabled:opacity-30">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  const track = document.getElementById("sibling-track");
  const nav = document.getElementById("sibling-nav");
  const prev = document.getElementById("sibling-prev") as HTMLButtonElement | null;
  const next = document.getElementById("sibling-next") as HTMLButtonElement | null;

  if (track && nav && prev && next) {
    const updateNav = () => {
      const hasOverflow = track.scrollWidth > track.clientWidth + 1;
      nav.classList.toggle("hidden", !hasOverflow);
      nav.classList.toggle("flex", hasOverflow);
      if (!hasOverflow) return;
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    const scrollByCard = (direction: number) => {
      const card = track.querySelector("a");
      const gap = 20;
      const cardWidth = card ? card.getBoundingClientRect().width + gap : 300;
      track.scrollBy({ left: direction * cardWidth, behavior: "smooth" });
    };

    prev.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
    track.addEventListener("scroll", updateNav, { passive: true });
    window.addEventListener("resize", updateNav);
    updateNav();
  }
</script>

<style>
  .sibling-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .sibling-track::-webkit-scrollbar {
    display: none;
  }
</style>
