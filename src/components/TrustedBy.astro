---
import { Image } from "astro:assets";
import starLogo from "../assets/logos/star-logo.png";

// "Trusted by" client-logo wall. Ref: a bold blue section, big heading, white
// rounded logo cards in a grid. Real client logos only (public/clients/) —
// "200+" reuses the same client figure already shown in About.astro rather
// than inventing a new number. ARM Motors' source file was a pure-white mark
// on a transparent background (invisible on a white card), recolored to the
// brand navy, same shape, during processing — not a fabricated logo, just
// made visible on a light surface.
interface Client {
  name: string;
  logo: string;
}

const clients: Client[] = [
  { name: "Birra Fragrances", logo: "/clients/client-1.webp" },
  { name: "AD Ports Group", logo: "/clients/client-2.webp" },
  { name: "ALEMCO", logo: "/clients/client-3.webp" },
  { name: "Biocon", logo: "/clients/client-4.webp" },
  { name: "Brothers Gas", logo: "/clients/client-5.webp" },
  { name: "Gulf Oil", logo: "/clients/client-6.webp" },
  { name: "Mitsubishi Electric", logo: "/clients/client-7.webp" },
  { name: "SAFCO", logo: "/clients/client-8.webp" },
  { name: "Saipem", logo: "/clients/client-9.webp" },
  { name: "Sony", logo: "/clients/client-10.webp" },
  { name: "Alex Renner Motors", logo: "/clients/client-11.webp" },
];
---

<section class="relative overflow-hidden bg-navy py-20 sm:py-24">
  <img
    src="/how-it-works/ship-aerial.webp"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-30"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-navy/95 via-brand-blue/80 to-navy/95" />

  <!-- same star-mark watermark idea as the footer, minus the engrave filter
       (that drop-shadow combo was tuned for a white background — here the
       mark's natural navy/red keeps a faint hint of color against the navy bg) -->
  <Image
    src={starLogo}
    alt=""
    aria-hidden="true"
    width={280}
    class="pointer-events-none absolute -top-6 -right-6 w-36 opacity-[0.18] select-none sm:w-48 md:-top-8 md:-right-8 md:w-72"
  />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="translate-y-8 text-center opacity-0 transition-all duration-700 ease-out">
      <h2 class="text-3xl leading-tight font-bold text-white sm:text-4xl lg:text-5xl">
        200+ companies trust<br />Alpha Star Shipping for their business
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-white/85">
        We offer complete, customized logistics solutions across the GCC, making cargo transportation and supply
        chain management easier and stress-free.
      </p>
    </div>

    <div
      data-reveal
      class="mt-14 flex translate-y-8 flex-wrap justify-center gap-4 opacity-0 transition-all delay-150 duration-700 ease-out sm:gap-5"
    >
      {
        clients.map((client) => (
          <div class="flex aspect-[3/2] w-[calc(50%-0.5rem)] items-center justify-center rounded-2xl bg-white p-4 shadow-sm sm:w-[calc(33.333%-0.834rem)] sm:p-5 lg:w-[calc(16.667%-1.042rem)]">
            <img src={client.logo} alt={client.name} class="h-full w-full object-contain" loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>
</section>
