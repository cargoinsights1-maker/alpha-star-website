---
import { Image } from "astro:assets";
import mainLogo from "../assets/logos/main-logo.png";
import starLogo from "../assets/logos/star-logo.png";

interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

// placeholder hrefs — swap for real profile URLs once supplied
interface SocialLink {
  label: string;
  href: string;
  path: string;
}

const socialLinks: SocialLink[] = [
  {
    label: "X (Twitter)",
    href: "#",
    path: "M18.9 2H22l-7.6 8.7L23 22h-6.6l-5.2-6.8L5.2 22H2l8.1-9.3L1.5 2H8.3l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z",
  },
  {
    label: "Facebook",
    href: "#",
    path: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z",
  },
];

// Instagram and LinkedIn use multi-shape marks, rendered separately below rather than a single path
---

<footer class="relative overflow-hidden border-t border-slate-200 bg-white text-navy">
  <!-- decorative watermark only — hidden from assistive tech -->
  <Image
    src={starLogo}
    alt=""
    aria-hidden="true"
    width={280}
    class="footer-watermark pointer-events-none absolute -top-6 -right-6 w-36 select-none opacity-[0.16] sm:w-48 md:-top-8 md:-right-8 md:w-72"
  />

  <div class="relative mx-auto max-w-7xl px-6 pt-16 pb-8 md:px-10">
    <div data-reveal class="grid translate-y-8 gap-12 opacity-0 transition-all duration-700 ease-out sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
      <div>
        <Image src={mainLogo} alt="Alpha Star Shipping" width={200} class="h-auto w-44" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-navy/60">
          Freight forwarding &amp; logistics solutions connecting the GCC to the world.
        </p>

        <a
          href="/downloads/alpha-star-catalogue.pdf"
          download
          class="group mt-6 inline-flex items-center gap-2 rounded-full bg-brand-red/10 px-5 py-2.5 text-sm font-semibold text-brand-red transition-all duration-300 hover:bg-brand-red/15"
        >
          Download Catalogue
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5">
            <path d="M12 3v12m0 0-4-4m4 4 4-4" />
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
          </svg>
        </a>

        <p class="mt-6 text-sm font-semibold tracking-wider text-navy uppercase">Connect With Us</p>
        <div class="mt-3 flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-navy/20 text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-red hover:text-brand-red hover:shadow-md hover:shadow-brand-red/20"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                  <path d={social.path} />
                </svg>
              </a>
            ))
          }
          <a
            href="#"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-navy/20 text-navy transition-colors hover:border-brand-red hover:text-brand-red"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="#"
            aria-label="LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-navy/20 text-navy transition-colors hover:border-brand-red hover:text-brand-red"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
        </div>
      </div>

      <nav aria-label="Footer">
        <h3 class="text-sm font-semibold tracking-wider text-navy uppercase">Navigate</h3>
        <ul class="mt-5 space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="inline-block text-sm text-navy/70 transition-all duration-300 hover:translate-x-1 hover:text-brand-red">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-semibold tracking-wider text-navy uppercase">Contact Us</h3>
        <ul class="mt-5 space-y-3 text-sm text-navy/70">
          <li>
            <a href="tel:+97142699820" class="flex items-center gap-2 transition-colors hover:text-brand-red">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-brand-red">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              +971 4 269 9820
            </a>
          </li>
          <li>
            <a href="mailto:mateen@alphastarshipping.com" class="flex items-center gap-2 transition-colors hover:text-brand-red">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-brand-red">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 6-10 7L2 6" />
              </svg>
              mateen@alphastarshipping.com
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold tracking-wider text-navy uppercase">Our Location</h3>
        <p class="mt-5 flex gap-2 text-sm leading-relaxed text-navy/70">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-red">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>P.O. Box 29252, 128 Community, 9A Street, Warehouse No. 8, Al Khabaisi, Deira, Dubai, UAE</span>
        </p>
      </div>
    </div>
  </div>

  <!-- tagline stays on the white section, same faint-watermark idea as the star icon, just smaller/italic -->
  <div class="relative border-t border-slate-200 bg-white pt-3 pb-6 text-center sm:pt-4 sm:pb-8">
    <p aria-hidden="true" class="pointer-events-none font-sans text-3xl font-bold tracking-tight text-brand-red/15 italic select-none sm:text-4xl md:text-5xl">
      The Lengths We Go&hellip;
    </p>
    <p class="sr-only">The Lengths We Go&hellip;</p>
  </div>

  <div class="bg-navy py-3 text-center text-xs text-white/60">
    &copy; {new Date().getFullYear()} Alpha Star Shipping. All Rights Reserved.
  </div>
</footer>

<style>
  /* faux-engraved watermark: grayscale + offset light/dark drop-shadows fake a pressed-in emboss on the white background */
  .footer-watermark {
    filter: grayscale(1) drop-shadow(1px 1px 0 rgba(255, 255, 255, 0.8)) drop-shadow(-1px -1px 0 rgba(21, 32, 86, 0.15));
  }
</style>
