---
// Home page spotlight for Warehousing & 3PL / JAFZA, mirroring ShipSpares.astro's
// proven light-section pattern (dot-grid texture, soft color blobs, capability
// pill row, vignette-masked photo card) but with its own identity: image on
// the left instead of the right (visual rhythm against the Ship Spares
// section right above it), no wave divider (that was a nautical motif
// specific to Ship Spares, not a general template), and a plain light
// background instead of the oceanic gradient. Copy is the client's own,
// condensed into three capability pointers drawn directly from it (bonded
// storage, cargo preparation / re-export, regional distribution).
interface Capability {
  label: string;
  icon: "warehouse" | "boxCheck" | "route";
}

const capabilities: Capability[] = [
  { label: "Bonded Storage", icon: "warehouse" },
  { label: "Cargo Prep & Re-Export", icon: "boxCheck" },
  { label: "Regional Distribution", icon: "route" },
];
---

<section class="relative overflow-hidden bg-white py-20 sm:py-24">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.4]"
    style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
  >
  </div>
  <div class="pointer-events-none absolute top-1/3 right-[-10%] h-[420px] w-[420px] -translate-y-1/2 rounded-full bg-brand-blue-light/20 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-[-8%] h-[380px] w-[380px] rounded-full bg-brand-red/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal class="-translate-x-10 opacity-0 transition-all duration-700 ease-out lg:order-1">
        <img
          src="/services/warehousing.webp"
          alt="Alpha Star bonded warehousing facility in JAFZA, Dubai"
          width="2000"
          height="1600"
          class="warehousing-photo aspect-[5/4] w-full rounded-[2rem] object-cover shadow-2xl shadow-brand-blue/20"
        />
      </div>

      <div data-reveal class="translate-y-8 opacity-0 transition-all delay-150 duration-700 ease-out lg:order-2">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Warehousing & 3PL</p>

        <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">JAFZA Hub</h2>
        <p class="mt-3 text-lg font-medium text-navy/80">A UAE base for storage, onward movement and distribution.</p>

        <p class="mt-5 max-w-lg leading-relaxed text-navy/70">
          Connect inbound freight with bonded storage, cargo preparation, re-export and regional distribution. Our
          JAFZA and mainland logistics capabilities support both individual shipments and continuing supply-chain
          requirements.
        </p>

        <ul class="mt-8 grid grid-cols-3 gap-3 sm:gap-4">
          {
            capabilities.map((capability) => (
              <li class="flex flex-col items-center gap-2.5 rounded-2xl border border-brand-blue/10 bg-slate-50 px-2 py-4 text-center shadow-sm">
                <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-gradient-to-br from-brand-blue to-brand-blue-light text-white shadow-lg shadow-brand-blue/25">
                  {capability.icon === "warehouse" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <path d="M3 11l9-6 9 6v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9Z" />
                      <path d="M9 21v-7h6v7" />
                    </svg>
                  )}
                  {capability.icon === "boxCheck" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <rect x="3" y="7" width="18" height="13" rx="1.5" />
                      <path d="M3 7l9-4 9 4" />
                      <path d="M9 13l2 2 4-4" />
                    </svg>
                  )}
                  {capability.icon === "route" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <path d="M4 18c4-10 12-10 16 0" />
                      <circle cx="4" cy="18" r="1.5" />
                      <circle cx="20" cy="18" r="1.5" />
                    </svg>
                  )}
                </span>
                <span class="text-xs leading-snug font-semibold text-navy sm:text-sm">{capability.label}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/warehousing-3pl"
          class="group mt-9 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-black/20 transition-shadow hover:shadow-xl"
        >
          Explore Warehousing & 3PL
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Same vignette-mask technique as Ship Spares' photo card — corners settle
     into the section instead of reading as a hard-edged box. */
  .warehousing-photo {
    -webkit-mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, black 78%, transparent 100%);
    mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, black 78%, transparent 100%);
  }
</style>
