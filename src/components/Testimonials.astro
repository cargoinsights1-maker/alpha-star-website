---
// Two rows of testimonial cards, auto-scrolling as an infinite marquee in
// opposite directions (pure CSS — no JS needed, unlike the scroll-linked
// mechanics in HowItWorks.astro, since this isn't tied to page scroll at all).
// Real testimonials from the client's own handover document
// (03_Testimonials/02_Testimonials_and_Case_Studies.pdf) — quotes kept
// verbatim (including source wording/typos) per that document's own
// instruction not to present polished marketing copy as a customer
// quotation. Country is only included where the source explicitly states
// it (in the heading, e.g. "Sudara, USA") — left blank rather than guessed
// where it wasn't given. Avatars are colored initials rather than stock
// photos, consistent with the rest of the site's "don't fabricate" approach
// to people who aren't actually pictured.
interface Testimonial {
  quote: string;
  name: string;
  company: string;
  country?: string;
  initials: string;
}

const rowOne: Testimonial[] = [
  {
    quote: "Alpha Star Shipping is a professional and reliable partner in achieving our goals. We have been able to find the Flexibility necessary for the continuity of our operation from them since the day we started working with.",
    name: "Cagri Ozmen",
    company: "Azur Aviation",
    initials: "CO",
  },
  {
    quote: "Alpha Star has been a great logistics partner for Sudara for a year now. We experienced significant savings on our import shipping of goods from India to the US. This was critical for our business during a difficult year with COVID related issues. The team at Alpha Star is very easy to work with and always quick to support our shipping needs. I would highly recommend Alpha Star.",
    name: "John Arathoon",
    company: "Sudara",
    country: "USA",
    initials: "JA",
  },
  {
    quote: "This is what is called a well-mastered file !!! Congratulations to all for this excellent service and the information you have made us follow as you go along. Our client is very happy with the follow-up and so are we. On this issue, I have only one word... perfect!!! Thanks again to you for your professionalism and we really hope, have other operations like this",
    name: "Thierry Bongiovanni",
    company: "Centrimex",
    initials: "TB",
  },
  {
    quote: "Good Job! Communication was so smooth and collaboration @ its peak! Many Thanks to you for your efforts and your team on this shipment Since cgnee have huge emergency on this file and same was treated very professionally and fast!!",
    name: "Shalinee Chotoree Poonith",
    company: "G & A Rapid Freight Co Ltd",
    initials: "SP",
  },
];

const rowTwo: Testimonial[] = [
  {
    quote: "I would like to thank you so much for your GREAT job regarding this shipment It was a TOP quality operation Thank you very MUCH to all the Team Alpha star!",
    name: "Daphnée Dessource",
    company: "Centrimex",
    country: "France",
    initials: "DD",
  },
  {
    quote: "Really appreciate all the hard work/ excellent services & your patience in handling this first shipment (we are expecting regular shipments from same shipper/ same consignee)",
    name: "Jawad Nasim Rana",
    company: "Pakistan Freight System",
    country: "Pakistan",
    initials: "JR",
  },
  {
    quote: "Well received with many thanks for your efforts throughout the shipment",
    name: "Sulyma Hakmeh",
    company: "eCargoWorld",
    country: "UAE",
    initials: "SH",
  },
];

const avatarTints = ["bg-navy", "bg-brand-blue", "bg-brand-red"];
---

<section class="relative overflow-hidden bg-slate-50 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="translate-y-8 text-center opacity-0 transition-all duration-700 ease-out">
      <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Testimonials</p>
      <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl lg:text-5xl">Words From Our Clients</h2>
    </div>
  </div>

  <div data-reveal class="mt-14 translate-y-8 space-y-6 opacity-0 transition-all delay-150 duration-700 ease-out">
    <div class="marquee-row">
      <div class="marquee-track marquee-left">
        {
          [...rowOne, ...rowOne].map((t, i) => (
            <article class="w-[19rem] flex-none rounded-3xl bg-white p-7 shadow-sm sm:w-[22rem]">
              <span class={`flex h-11 w-11 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue`}>
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                  <path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.83v-6.83H4.5a2.67 2.67 0 0 1 2.67-2.67V6Zm10 0A5.17 5.17 0 0 0 12 11.17V18h6.83v-6.83H14.5a2.67 2.67 0 0 1 2.67-2.67V6Z" />
                </svg>
              </span>
              <p class="mt-5 text-sm leading-relaxed text-navy/80">{t.quote}</p>
              <div class="mt-6 flex items-center gap-3">
                <span class={`flex h-10 w-10 flex-none items-center justify-center rounded-full text-xs font-semibold text-white ${avatarTints[i % avatarTints.length]}`}>
                  {t.initials}
                </span>
                <div>
                  <p class="text-sm font-bold text-navy">{t.name}</p>
                  <p class="text-xs text-navy/50">
                    {t.company}{t.country && `, ${t.country}`}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="marquee-row">
      <div class="marquee-track marquee-right">
        {
          [...rowTwo, ...rowTwo].map((t, i) => (
            <article class="w-[19rem] flex-none rounded-3xl bg-white p-7 shadow-sm sm:w-[22rem]">
              <span class={`flex h-11 w-11 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue`}>
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                  <path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.83v-6.83H4.5a2.67 2.67 0 0 1 2.67-2.67V6Zm10 0A5.17 5.17 0 0 0 12 11.17V18h6.83v-6.83H14.5a2.67 2.67 0 0 1 2.67-2.67V6Z" />
                </svg>
              </span>
              <p class="mt-5 text-sm leading-relaxed text-navy/80">{t.quote}</p>
              <div class="mt-6 flex items-center gap-3">
                <span class={`flex h-10 w-10 flex-none items-center justify-center rounded-full text-xs font-semibold text-white ${avatarTints[(i + 1) % avatarTints.length]}`}>
                  {t.initials}
                </span>
                <div>
                  <p class="text-sm font-bold text-navy">{t.name}</p>
                  <p class="text-xs text-navy/50">
                    {t.company}{t.country && `, ${t.country}`}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    animation: marquee 50s linear infinite;
  }

  .marquee-track.marquee-right {
    animation-direction: reverse;
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .marquee-row {
      overflow-x: auto;
    }
  }
</style>
