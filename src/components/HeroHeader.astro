---
// Style 1 of 3: the hero-only overlay nav. Identical layout at every viewport
// width on purpose (hamburger left, logo center, CTA right) — this is the one
// navbar style that doesn't change between desktop and mobile.
import { Image } from "astro:assets";
import whiteLogo from "../assets/logos/white-logo.png";
import { navLinksBefore, navLinksAfter } from "../data/nav";

const menuLinks = [
  ...navLinksBefore,
  { label: "Services", href: "/services" },
  { label: "Industries", href: "/services#industries" },
  ...navLinksAfter,
];
---

<div class="absolute inset-x-0 top-0 z-40">
  <!-- scrim so the nav stays legible over bright footage, independent of video/image content -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/50 to-transparent" />

  <div class="relative mx-auto grid max-w-7xl grid-cols-3 items-center px-4 py-5 sm:px-6 lg:px-8">
    <div class="flex justify-start">
      <button
        id="hero-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="hero-menu"
        aria-label="Open menu"
        class="flex items-center gap-2 text-sm font-medium text-white"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>

    <a href="/" class="flex justify-center">
      <Image src={whiteLogo} alt="Alpha Star Shipping" width={220} class="h-8 w-auto sm:h-12 md:h-14" />
    </a>

    <div class="flex justify-end">
      <a
        href="/contact"
        class="group inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 px-3 py-2 text-sm font-semibold whitespace-nowrap text-white backdrop-blur transition-colors hover:bg-white/20 sm:px-5"
      >
        Contact Us
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-3.5 w-3.5 transition-transform group-hover:translate-x-1 sm:inline">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</div>

<div
  id="hero-menu"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-[60] flex scale-95 flex-col bg-navy/98 opacity-0 backdrop-blur transition-all duration-300 ease-out"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-5 sm:px-6 lg:px-8">
    <Image src={whiteLogo} alt="Alpha Star Shipping" width={170} class="h-8 w-auto sm:h-9" />
    <button id="hero-menu-close" type="button" aria-label="Close menu" class="flex h-10 w-10 items-center justify-center rounded-full text-white">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav aria-label="Primary" class="flex flex-1 flex-col items-center justify-center gap-4 overflow-y-auto px-6 py-8">
    {
      menuLinks.map((link, i) => (
        <a
          href={link.href}
          data-menu-link
          style={`transition-delay: ${i * 60}ms`}
          class="translate-y-3 text-3xl font-semibold text-white opacity-0 transition-all duration-500 ease-out hover:text-brand-red sm:text-4xl"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const toggle = document.getElementById("hero-menu-toggle");
  const closeBtn = document.getElementById("hero-menu-close");
  const menu = document.getElementById("hero-menu");
  const menuLinks = document.querySelectorAll("[data-menu-link]");

  const openMenu = () => {
    menu?.classList.remove("opacity-0", "scale-95", "pointer-events-none");
    menu?.classList.add("opacity-100", "scale-100", "pointer-events-auto");
    menu?.setAttribute("aria-hidden", "false");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    menuLinks.forEach((link) => link.classList.remove("opacity-0", "translate-y-3"));
  };

  const closeMenu = () => {
    menu?.classList.add("opacity-0", "scale-95", "pointer-events-none");
    menu?.classList.remove("opacity-100", "scale-100", "pointer-events-auto");
    menu?.setAttribute("aria-hidden", "true");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    menuLinks.forEach((link) => link.classList.add("opacity-0", "translate-y-3"));
  };

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
</script>
