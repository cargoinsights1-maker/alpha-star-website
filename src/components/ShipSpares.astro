---
// Home page positioning section for Ship Spares — kept as a short, confident
// "we specialize in this" statement rather than a deep explainer (the fuller
// problem/solution and door-to-deck journey content is reserved for a future
// dedicated /ship-spares page). Copy is grounded directly in the client's
// own text; quick industry research (GAC/Eurosender/Wrist Marine service
// pages) confirmed the real emphasis is urgency + 24/7 responsiveness +
// door-to-deck delivery, matching the Ship Spares sub-items already in
// src/data/nav.ts.
//
// Third pass, after two rejected dark-theme directions: user wants a
// whitish, minimal section instead, with a real ship and the text split
// across two columns. Reused About.astro's light-section language directly
// (dot-grid texture, navy headings, red-gradient pill CTA with arrow) so
// this section matches the rest of the light pages rather than inventing a
// third visual style. Background got a soft oceanic gradient + blurred
// blobs + wave divider after "too plain" feedback on the first flat-white
// attempt, and the three capability pointers became a side-by-side row of
// cards instead of a stacked list, per explicit request.
//
// Fourth pass: user supplied a real diagonal aerial ship photo and asked
// for it on the right with text on the left (the original had a thin
// cropped strip of an older photo on the left — that's now replaced
// entirely, and the column order flipped to match the new reference). This
// photo stands fine on its own as a rounded photo card (unlike the old
// strip, which needed a heavy edge-fade to avoid looking like an awkward
// sliver) — kept just a light vignette at the very edges so it still feels
// like it's gently settling into the section rather than sitting in a hard
// box. Reveal direction flipped too (slides in from the right now, since
// that's where the image actually sits).
interface Capability {
  label: string;
  icon: "anchor" | "clock" | "shield";
}

const capabilities: Capability[] = [
  { label: "Door-to-Deck Delivery", icon: "anchor" },
  { label: "24/7 Urgent Support", icon: "clock" },
  { label: "Customs & Transit Handling", icon: "shield" },
];
---

<section class="relative overflow-hidden bg-gradient-to-b from-sky-50 via-white to-blue-50 pt-36 pb-20 sm:pb-24">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.4]"
    style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
  >
  </div>
  <div class="pointer-events-none absolute top-0 left-[-10%] h-[420px] w-[420px] rounded-full bg-brand-blue-light/20 blur-3xl"></div>
  <div class="pointer-events-none absolute right-[-8%] bottom-0 h-[380px] w-[380px] rounded-full bg-brand-blue/15 blur-3xl"></div>
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-24 w-full text-sky-100/80 sm:h-32" viewBox="0 0 1440 120" preserveAspectRatio="none" fill="currentColor">
    <path d="M0,60 C240,100 480,10 720,50 C960,90 1200,20 1440,55 L1440,120 L0,120 Z" />
  </svg>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">24/7 Ship Spares Logistics</p>

        <h2 class="font-display mt-4 text-4xl leading-[1.05] tracking-wide text-navy uppercase sm:text-5xl">
          Leading Ship Spares Logistics in the UAE
        </h2>

        <p class="mt-6 max-w-lg leading-relaxed text-navy/70">
          Alpha Star serves customers across the ship spares industry in Europe, the USA, Middle East and Far East
          Asia. Spares arrive through every mode of logistics, and because delivery is time bound, our team stays
          active 24/7 to get every shipment to the vessel on time.
        </p>

        <ul class="mt-8 grid grid-cols-3 gap-3 sm:gap-4">
          {
            capabilities.map((capability) => (
              <li class="flex flex-col items-center gap-2.5 rounded-2xl border border-brand-blue/10 bg-white/60 px-2 py-4 text-center shadow-sm backdrop-blur-sm">
                <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-gradient-to-br from-brand-blue to-brand-blue-light text-white shadow-lg shadow-brand-blue/25">
                  {capability.icon === "anchor" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <circle cx="12" cy="5" r="2" />
                      <path d="M12 7v13M6 13H3a9 9 0 0 0 9 7 9 9 0 0 0 9-7h-3M8 10l-2 3M16 10l2 3" />
                    </svg>
                  )}
                  {capability.icon === "clock" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3.5 2" />
                    </svg>
                  )}
                  {capability.icon === "shield" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                      <path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3Z" />
                      <path d="M9.5 12l2 2 3.5-4" />
                    </svg>
                  )}
                </span>
                <span class="text-xs leading-snug font-semibold text-navy sm:text-sm">{capability.label}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/ship-spares"
          class="group mt-9 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-black/20 transition-shadow hover:shadow-xl"
        >
          Explore Ship Spares
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div data-reveal class="translate-x-10 opacity-0 transition-all delay-150 duration-700 ease-out">
        <img
          src="/ship-spares/ship-diagonal.webp"
          alt="Alpha Star container ship at sea"
          width="2000"
          height="1332"
          class="ship-photo aspect-[5/4] w-full rounded-[2rem] object-cover shadow-2xl shadow-brand-blue/20"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Light vignette so the card's corners settle into the section rather
     than reading as a hard-edged box, without hiding most of the photo
     the way the old thin ship-strip's heavy fade had to. */
  .ship-photo {
    -webkit-mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, black 78%, transparent 100%);
    mask-image: radial-gradient(ellipse 92% 92% at 50% 50%, black 78%, transparent 100%);
  }
</style>
