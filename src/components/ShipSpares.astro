---
// Home page positioning section for Ship Spares — kept as a short, confident
// "we specialize in this" statement rather than a deep explainer (the fuller
// problem/solution and door-to-deck journey content is reserved for a future
// dedicated /ship-spares page). Copy is grounded directly in the client's
// own text; quick industry research (GAC/Eurosender/Wrist Marine service
// pages) confirmed the real emphasis is urgency + 24/7 responsiveness +
// door-to-deck delivery, matching the Ship Spares sub-items already in
// src/data/nav.ts.
//
// Third pass, after two rejected directions (a dark-navy glass-card version,
// then a dark version with an abstract route-map background): user wants a
// whitish, minimal section instead, with a real ship "scrolling through"
// from the left and the text on the right — no map motif at all this time.
// Reused About.astro's light-section language directly (dot-grid texture,
// navy headings, red-gradient pill CTA with arrow) so this section matches
// the rest of the light pages rather than inventing a third visual style.
// The ship photo is the same aerial container-ship source already used in
// HowItWorks.astro, cropped to a tight horizontal strip around just the
// hull (bbox found by classifying water vs. ship pixels rather than
// eyeballing crop coordinates) — no second ship photo was available, and
// the treatment here (a thin strip fading into a white section) reads
// differently enough from HowItWorks' full-bleed scroll-pinned pan that it
// doesn't feel like repeating the same visual.
interface Capability {
  label: string;
  icon: "anchor" | "clock" | "shield";
}

const capabilities: Capability[] = [
  { label: "Door-to-Deck Delivery", icon: "anchor" },
  { label: "24/7 Urgent Support", icon: "clock" },
  { label: "Customs & Transit Handling", icon: "shield" },
];
---

<section class="relative overflow-hidden bg-white py-20 sm:py-24">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.4]"
    style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal class="relative -translate-x-10 opacity-0 transition-all duration-700 ease-out">
        <div class="relative">
          <img
            src="/ship-spares/ship-aerial-strip.webp"
            alt="Alpha Star container ship"
            width="1800"
            height="294"
            class="w-full"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-white to-transparent sm:w-24" />
          <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-white to-transparent sm:w-24" />
          <div class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-white to-transparent" />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-white to-transparent" />
        </div>
      </div>

      <div data-reveal class="translate-y-8 opacity-0 transition-all delay-150 duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">24/7 Ship Spares Logistics</p>

        <h2 class="font-display mt-4 text-4xl leading-[1.05] tracking-wide text-navy uppercase sm:text-5xl">
          Leading Ship Spares Logistics in the UAE
        </h2>

        <p class="mt-6 max-w-lg leading-relaxed text-navy/70">
          Alpha Star serves customers across the ship spares industry in Europe, the USA, Middle East and Far East
          Asia. Spares arrive through every mode of logistics, and because delivery is time bound, our team stays
          active 24/7 to get every shipment to the vessel on time.
        </p>

        <ul class="mt-8 flex flex-col gap-4">
          {
            capabilities.map((capability) => (
              <li class="flex items-center gap-3 text-sm font-medium text-navy sm:text-base">
                <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-gradient-to-br from-brand-blue to-brand-blue-light text-white shadow-lg shadow-brand-blue/25">
                  {capability.icon === "anchor" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <circle cx="12" cy="5" r="2" />
                      <path d="M12 7v13M6 13H3a9 9 0 0 0 9 7 9 9 0 0 0 9-7h-3M8 10l-2 3M16 10l2 3" />
                    </svg>
                  )}
                  {capability.icon === "clock" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3.5 2" />
                    </svg>
                  )}
                  {capability.icon === "shield" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3Z" />
                      <path d="M9.5 12l2 2 3.5-4" />
                    </svg>
                  )}
                </span>
                {capability.label}
              </li>
            ))
          }
        </ul>

        <a
          href="/ship-spares"
          class="group mt-9 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-black/20 transition-shadow hover:shadow-xl"
        >
          Explore Ship Spares
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
