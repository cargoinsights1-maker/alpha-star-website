---
// Home page positioning section for Ship Spares — kept as a short, confident
// "we specialize in this" statement rather than a deep explainer (the fuller
// problem/solution and door-to-deck journey content is reserved for a future
// dedicated /ship-spares page). Copy is grounded directly in the client's
// own text; quick industry research (GAC/Eurosender/Wrist Marine service
// pages) confirmed the real emphasis is urgency + 24/7 responsiveness +
// door-to-deck delivery, matching the Ship Spares sub-items already in
// src/data/nav.ts. "24/7" is the single most-repeated idea in the client's
// copy, so it's the visual anchor here (same gradient-stat pattern as
// About.astro's quick stats, just white-based for this dark background).
//
// Styling takes cues from two "premium" reference screenshots the user
// shared (bold uppercase gradient headline, eyebrow pill badge, circular-
// arrow-badge CTA): the button reuses ContactCTA.astro's exact
// .cta-button/.cta-button-icon pattern, and the headline reuses the Oswald
// display font already loaded for that section rather than adding a third
// typeface.
//
// Redesigned per feedback on the first version: dropped the "Regions We
// Serve" badge card (read as a map, which competed with the actual map
// motif below) in favor of a photographic cutout — reusing ContactCTA's
// container-cutout.png, since a shipping container is the one real asset
// on hand that reads as "ship spares logistics" — flowing in from the left
// with its own horizontal reveal, text + a few capability icons (pulled
// from the real Ship Spares nav sub-items, not invented) on the right, and
// an abstract global shipping-route graphic standing in for the "premium
// map background" instead of a literal (and licensing-risky) world map
// image — three dashed routes converging on port-style nodes reads as
// "global network" without needing real geographic map data.
interface Capability {
  label: string;
  icon: "anchor" | "clock" | "shield";
}

const capabilities: Capability[] = [
  { label: "Door-to-Deck Delivery", icon: "anchor" },
  { label: "24/7 Urgent Support", icon: "clock" },
  { label: "Customs & Transit Handling", icon: "shield" },
];
---

<section class="relative overflow-hidden bg-gradient-to-br from-navy via-[#0d3550] to-navy py-20 sm:py-24">
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full text-white/15"
    viewBox="0 0 800 400"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    <path d="M0 60H800M0 140H800M0 220H800M0 300H800" stroke="currentColor" stroke-width="1" />
    <path d="M80 0V400M260 0V400M440 0V400M620 0V400" stroke="currentColor" stroke-width="1" />
    <path d="M70 320C220 220 300 120 460 100C560 90 620 150 740 70" stroke="#d81f2a" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round" />
    <path d="M40 150C160 180 260 260 420 250C520 245 600 300 760 260" stroke="#d81f2a" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round" />
    <g fill="#d81f2a" fill-opacity="0.55">
      <circle cx="70" cy="320" r="3.5" /><circle cx="460" cy="100" r="3.5" /><circle cx="740" cy="70" r="3.5" />
      <circle cx="40" cy="150" r="3.5" /><circle cx="420" cy="250" r="3.5" /><circle cx="760" cy="260" r="3.5" />
    </g>
  </svg>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-10">
      <div
        data-reveal
        class="relative -translate-x-10 opacity-0 transition-all duration-700 ease-out lg:-ml-6"
      >
        <div class="ss-image-glow pointer-events-none absolute inset-0" aria-hidden="true" />
        <img
          src="/cta/container-cutout.png"
          alt="Alpha Star shipping container"
          width="1800"
          height="675"
          class="relative mx-auto w-full max-w-xl drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]"
        />
      </div>

      <div data-reveal class="translate-y-8 opacity-0 transition-all delay-150 duration-700 ease-out">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-xs font-semibold tracking-wide text-white/80 backdrop-blur">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-brand-red">
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" />
          </svg>
          24/7 Ship Spares Logistics
        </span>

        <h2 class="ship-spares-heading font-display mt-6 text-4xl leading-[1.05] tracking-wide text-white uppercase sm:text-5xl lg:text-6xl">
          Leading Ship Spares Logistics in the UAE
        </h2>

        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
          Alpha Star serves customers across the ship spares industry in Europe, the USA, Middle East and Far East
          Asia. Spares arrive through every mode of logistics, and because delivery is time bound, our team stays
          active 24/7 to get every shipment to the vessel on time.
        </p>

        <ul class="mt-8 flex flex-col gap-4">
          {
            capabilities.map((capability) => (
              <li class="flex items-center gap-3 text-sm font-medium text-white/85 sm:text-base">
                <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-white/10 text-brand-red">
                  {capability.icon === "anchor" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <circle cx="12" cy="5" r="2" />
                      <path d="M12 7v13M6 13H3a9 9 0 0 0 9 7 9 9 0 0 0 9-7h-3M8 10l-2 3M16 10l2 3" />
                    </svg>
                  )}
                  {capability.icon === "clock" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3.5 2" />
                    </svg>
                  )}
                  {capability.icon === "shield" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
                      <path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3Z" />
                      <path d="M9.5 12l2 2 3.5-4" />
                    </svg>
                  )}
                </span>
                {capability.label}
              </li>
            ))
          }
        </ul>

        <a
          href="/ship-spares"
          class="ss-button group mt-9 inline-flex items-center gap-3 rounded-full py-1.5 pr-1.5 pl-7 text-sm font-bold text-navy transition-all duration-300 hover:-translate-y-0.5 sm:text-base"
        >
          Explore Ship Spares
          <span class="ss-button-icon flex h-9 w-9 flex-none items-center justify-center rounded-full text-white transition-transform duration-300 group-hover:translate-x-1 group-hover:rotate-45">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ship-spares-heading {
    text-shadow:
      0 -1px 0 rgba(255, 255, 255, 0.2),
      0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .ss-button {
    background: linear-gradient(to bottom, #ffffff, #f3f4f6);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .ss-button:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 14px 36px rgba(0, 0, 0, 0.4);
  }

  .ss-button-icon {
    background: linear-gradient(135deg, #d81f2a, #a3121c);
  }

  .ss-image-glow {
    background: radial-gradient(ellipse 60% 55% at 50% 50%, rgba(216, 31, 42, 0.25) 0%, transparent 70%);
    filter: blur(20px);
  }
</style>
