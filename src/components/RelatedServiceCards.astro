---
// Same snap-scroll card track as Services.astro's home-page slider (image
// layered over a gradient fallback, arrow badge, label) so "related
// services" reads as a continuation of that pattern rather than a new one.
// A missing photo (e.g. Multimodal, which has none yet) falls back to the
// gradient alone, same graceful-placeholder convention used everywhere else.
interface RelatedService {
  slug: string;
  label: string;
  href: string;
  image?: string;
}

interface Props {
  items: RelatedService[];
}

const { items } = Astro.props;

const gradients = [
  "linear-gradient(135deg, #152056, #12557f)",
  "linear-gradient(135deg, #12557f, #2f8fc9)",
  "linear-gradient(135deg, #152056, #d81f2a)",
  "linear-gradient(135deg, #2f8fc9, #12557f)",
];
---

<div class="relative mt-6">
  <div id="related-track" class="related-track flex snap-x snap-mandatory gap-5 overflow-x-auto">
    {
      items.map((service, i) => (
        <a
          href={service.href}
          style={`background: ${service.image ? `url('${service.image}') center/cover no-repeat, ` : ""}${gradients[i % gradients.length]};`}
          class="group relative aspect-[3/2] w-[85%] flex-none snap-start overflow-hidden rounded-3xl sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)]"
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
          <span class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-all duration-300 group-hover:rotate-45 group-hover:bg-brand-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </span>
          <span class="absolute bottom-5 left-5 text-lg font-bold text-white">{service.label}</span>
        </a>
      ))
    }
  </div>

  {
    items.length > 2 && (
      <div class="mt-6 flex justify-end gap-3">
        <button id="related-prev" type="button" aria-label="Previous related service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
        </button>
        <button id="related-next" type="button" aria-label="Next related service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    )
  }
</div>

<script>
  const track = document.getElementById("related-track");
  const prev = document.getElementById("related-prev");
  const next = document.getElementById("related-next");

  const scrollByCard = (direction: number) => {
    if (!track) return;
    const card = track.querySelector("a");
    const gap = 20;
    const cardWidth = card ? card.getBoundingClientRect().width + gap : 300;
    track.scrollBy({ left: direction * cardWidth, behavior: "smooth" });
  };

  prev?.addEventListener("click", () => scrollByCard(-1));
  next?.addEventListener("click", () => scrollByCard(1));
</script>

<style>
  .related-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .related-track::-webkit-scrollbar {
    display: none;
  }
</style>
