---
// Same snap-scroll card track as Services.astro's home-page slider (image
// layered over a gradient fallback, arrow badge, label) so "related
// services" reads as a continuation of that pattern rather than a new one.
// A missing photo (e.g. Multimodal, which has none yet) falls back to the
// gradient alone, same graceful-placeholder convention used everywhere else.
interface RelatedService {
  slug: string;
  label: string;
  href: string;
  image?: string;
}

interface Props {
  items: RelatedService[];
}

const { items } = Astro.props;

const gradients = [
  "linear-gradient(135deg, #152056, #12557f)",
  "linear-gradient(135deg, #12557f, #2f8fc9)",
  "linear-gradient(135deg, #152056, #d81f2a)",
  "linear-gradient(135deg, #2f8fc9, #12557f)",
];
---

<div class="relative mt-6">
  <div id="related-track" class="related-track flex snap-x snap-mandatory gap-5 overflow-x-auto">
    {
      items.map((service, i) => (
        <a
          href={service.href}
          style={`background: ${service.image ? `url('${service.image}') center/cover no-repeat, ` : ""}${gradients[i % gradients.length]};`}
          class="group relative aspect-[3/2] w-[85%] flex-none snap-start overflow-hidden rounded-3xl sm:w-[calc((100%-1.25rem)/2)] lg:w-[420px]"
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
          <span class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition-all duration-300 group-hover:rotate-45 group-hover:bg-brand-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </span>
          <span class="absolute bottom-5 left-5 text-lg font-bold text-white">{service.label}</span>
        </a>
      ))
    }
  </div>

  <div id="related-nav" class="mt-6 hidden justify-end gap-3">
    <button id="related-prev" type="button" aria-label="Previous related service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white disabled:pointer-events-none disabled:opacity-30">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="related-next" type="button" aria-label="Next related service" class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-navy transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white disabled:pointer-events-none disabled:opacity-30">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  const track = document.getElementById("related-track");
  const nav = document.getElementById("related-nav");
  const prev = document.getElementById("related-prev") as HTMLButtonElement | null;
  const next = document.getElementById("related-next") as HTMLButtonElement | null;

  if (track && nav && prev && next) {
    // The nav only makes sense once the track actually overflows — with few
    // related items it often fits the row exactly at wide breakpoints, and
    // showing live-looking buttons that do nothing reads as broken.
    const updateNav = () => {
      const hasOverflow = track.scrollWidth > track.clientWidth + 1;
      nav.classList.toggle("hidden", !hasOverflow);
      nav.classList.toggle("flex", hasOverflow);
      if (!hasOverflow) return;
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    const scrollByCard = (direction: number) => {
      const card = track.querySelector("a");
      const gap = 20;
      const cardWidth = card ? card.getBoundingClientRect().width + gap : 300;
      track.scrollBy({ left: direction * cardWidth, behavior: "smooth" });
    };

    prev.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
    track.addEventListener("scroll", updateNav, { passive: true });
    window.addEventListener("resize", updateNav);
    updateNav();
  }
</script>

<style>
  .related-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .related-track::-webkit-scrollbar {
    display: none;
  }
</style>
