---
// Real industry photography is pending (see public/industries/README.md).
// Same graceful-placeholder pattern as Services.astro/ProjectsGallery.astro:
// each tile's CSS background layers a photo URL over a brand-color gradient,
// so a missing .webp fails silently and the gradient alone carries the tile.
// Layout matches the user's reference: full-bleed edge-to-edge photo tiles (no
// rounding, no gaps), caption overlaid at the bottom on a light scrim with a
// thin red accent line underneath, rather than a rounded card + caption below.
interface Industry {
  slug: string;
  label: string;
}

const industries: Industry[] = [
  { slug: "dangerous-goods", label: "Dangerous Goods" },
  { slug: "pharma", label: "Pharma" },
  { slug: "ship-spares", label: "Ship Spares" },
  { slug: "automobiles", label: "Automobiles" },
  { slug: "perishables", label: "Perishables" },
  { slug: "heavy-perishables", label: "Heavy Perishables" },
  { slug: "oil-gas", label: "Oil & Gas" },
  { slug: "project-cargo", label: "Project Cargo" },
];

const gradients = [
  "linear-gradient(135deg, #152056, #12557f)",
  "linear-gradient(135deg, #12557f, #2f8fc9)",
  "linear-gradient(135deg, #152056, #d81f2a)",
  "linear-gradient(135deg, #2f8fc9, #12557f)",
];
---

<section id="industries-section" class="relative overflow-hidden py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-reveal class="translate-y-8 text-center opacity-0 transition-all duration-700 ease-out">
      <h2 class="text-3xl font-extrabold tracking-wide text-navy uppercase sm:text-4xl lg:text-5xl">
        Trusted Across Industries
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-1.5 lg:grid-cols-4 lg:gap-2">
      {
        industries.map((industry, i) => (
          <div data-reveal style={`transition-delay: ${(i % 4) * 80}ms`} class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
            <div class="group relative aspect-[4/3] overflow-hidden">
              <div
                style={`background: url('/industries/${industry.slug}.webp') center/cover no-repeat, ${gradients[i % gradients.length]};`}
                class="absolute inset-0 scale-100 transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-white via-white/70 to-transparent" />
              <p class="absolute inset-x-0 bottom-3 text-center text-sm font-extrabold tracking-wide text-navy uppercase sm:text-base">
                {industry.label}
              </p>
              <div class="absolute inset-x-0 bottom-0 h-[3px] bg-brand-red" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
