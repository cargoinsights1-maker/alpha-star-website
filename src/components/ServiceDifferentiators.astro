---
interface Differentiator {
  label: string;
  description: string;
  icon: string;
}

interface Props {
  items: Differentiator[];
  // defaults match every existing usage (brand-blue); pass both to re-theme
  // a one-off section (e.g. an airline's own brand color) without touching
  // the other 8+ pages that use this component with no props.
  accentFrom?: string;
  accentTo?: string;
}

const { items, accentFrom = "#12557f", accentTo = "#2f8fc9" } = Astro.props;
---

<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
  {
    items.map((item, i) => (
      <div
        data-reveal
        style={`transition-delay: ${i * 120}ms`}
        class="translate-y-8 rounded-2xl border border-brand-blue/10 bg-white/60 p-5 opacity-0 shadow-sm backdrop-blur-sm transition-all duration-700 ease-out"
      >
        <span
          style={`background: linear-gradient(135deg, ${accentFrom}, ${accentTo}); box-shadow: 0 10px 20px -5px ${accentFrom}40;`}
          class="flex h-11 w-11 items-center justify-center rounded-full text-white"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" set:html={item.icon} />
        </span>
        <p class="mt-3 text-sm font-semibold text-navy sm:text-base">{item.label}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-navy/60">{item.description}</p>
      </div>
    ))
  }
</div>
