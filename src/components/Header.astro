---
// Style 2 of 3: the standard site navbar (rest-of-website). The hero-only
// overlay variant and the dedicated mobile design come later as separate tasks —
// the hamburger below is a functional-but-unstyled placeholder until then.
//
// Full nav structure replaced per the client's supplied sitemap: Home,
// Services (mega-menu), Ship Spares, Warehousing & 3PL, Industries, Airline
// Cargo Representation, then a single Contact Us button (previously two
// CTAs — simplified to match the spec's single "contact us button"). Insights
// and Our Team are footer-only by design, not part of this header at all.
import { Image } from "astro:assets";
import mainLogo from "../assets/logos/main-logo.png";
import NavDropdown from "./NavDropdown.astro";
import NavMegaMenu from "./NavMegaMenu.astro";
import {
  homeLink,
  servicesMegaMenu,
  shipSparesItems,
  warehousingItems,
  industryItems,
  airlineCargoItems,
} from "../data/nav";

interface Props {
  // when true, the header starts hidden above the viewport and only reveals
  // itself (already pinned at top) once the page scrolls past one viewport
  // height — used after a full-height Hero so it doesn't visibly slide up
  // into view from the bottom the way plain `sticky` would. Default (false)
  // is a normal always-visible sticky nav, for pages with no hero above it.
  revealOnScroll?: boolean;
}

const { revealOnScroll = false } = Astro.props;
---

<header
  id="site-header"
  data-reveal-on-scroll={revealOnScroll}
  class:list={[
    "top-0 z-50 w-full border-b border-slate-200 bg-white",
    revealOnScroll ? "fixed -translate-y-full transition-transform duration-300" : "sticky",
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-[72px] items-center justify-between">
      <a href="/" class="shrink-0">
        <Image src={mainLogo} alt="Alpha Star Shipping" width={170} class="h-9 w-auto sm:h-10" />
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-5 lg:flex lg:gap-6">
        <a href={homeLink.href} class="text-sm font-medium text-navy transition-colors hover:text-brand-red">
          {homeLink.label}
        </a>

        <NavMegaMenu label="Services" href="/services" columns={servicesMegaMenu} />

        <NavDropdown
          label="Ship Spares"
          href="/ship-spares"
          eyebrow="Marine Support"
          title="Ship Spares"
          gradientClass="from-navy to-brand-red"
          items={shipSparesItems}
        />

        <NavDropdown
          label="Warehousing & 3PL"
          href="/warehousing-3pl"
          eyebrow="Storage & Fulfilment"
          title="Warehousing & 3PL"
          gradientClass="from-navy via-brand-blue to-brand-blue-light"
          items={warehousingItems}
        />

        <NavDropdown
          label="Industries"
          href="/industries"
          eyebrow="Who We Serve"
          title="Our Industries"
          gradientClass="from-navy to-brand-red"
          items={industryItems}
        />

        <NavDropdown
          label="Airline Cargo Representation"
          href="/airline-cargo-representation"
          eyebrow="Airline Partners"
          title="Cargo Representation"
          gradientClass="from-navy via-brand-blue to-brand-blue-light"
          items={airlineCargoItems}
        />
      </nav>

      <div class="hidden lg:flex">
        <a
          href="/contact"
          class="group inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-black/10 transition-shadow hover:shadow-lg"
        >
          Contact Us
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <button
        id="mobile-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle menu"
        class="flex h-9 w-9 items-center justify-center rounded-full text-navy lg:hidden"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  {/* grid-rows-[0fr]→[1fr] trick animates to auto height smoothly, which a plain hidden toggle can't do */}
  <div id="mobile-nav" class="grid grid-rows-[0fr] overflow-hidden opacity-0 transition-all duration-300 ease-out lg:hidden">
    <div class="max-h-[70vh] overflow-y-auto border-t border-slate-200 bg-white p-4">
      <a href={homeLink.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
        {homeLink.label}
      </a>

      <details class="group/d">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
          Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-open/d:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="pb-2 pl-3">
          {
            servicesMegaMenu.map((column) => (
              <div class="mt-2">
                <a href={column.headingHref} class="block px-3 py-1 text-xs font-semibold tracking-wider text-navy/50 uppercase">
                  {column.heading}
                </a>
                {column.items.map((item) => (
                  <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-navy/80 hover:bg-brand-red/5 hover:text-brand-red">
                    {item.label}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </details>

      <details class="group/d">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
          Ship Spares
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-open/d:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="pb-2 pl-3">
          {
            shipSparesItems.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-navy/80 hover:bg-brand-red/5 hover:text-brand-red">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>

      <details class="group/d">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
          Warehousing & 3PL
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-open/d:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="pb-2 pl-3">
          {
            warehousingItems.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-navy/80 hover:bg-brand-red/5 hover:text-brand-red">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>

      <details class="group/d">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
          Industries
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-open/d:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="pb-2 pl-3">
          {
            industryItems.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-navy/80 hover:bg-brand-red/5 hover:text-brand-red">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>

      <details class="group/d">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-brand-red/5 hover:text-brand-red">
          Airline Cargo Representation
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-open/d:rotate-180">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="pb-2 pl-3">
          {
            airlineCargoItems.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2 text-sm text-navy/80 hover:bg-brand-red/5 hover:text-brand-red">
                {item.label}
              </a>
            ))
          }
        </div>
      </details>

      <div class="mt-3">
        <a href="/contact" class="group inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-4 py-2.5 text-sm font-semibold text-white">
          Contact Us
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { onScroll } from "../scripts/onScroll";

  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const willOpen = !panel?.classList.contains("grid-rows-[1fr]");
    panel?.classList.toggle("grid-rows-[1fr]", willOpen);
    panel?.classList.toggle("opacity-100", willOpen);
    panel?.classList.toggle("grid-rows-[0fr]", !willOpen);
    panel?.classList.toggle("opacity-0", !willOpen);
    toggle.setAttribute("aria-expanded", String(willOpen));
  });

  const header = document.getElementById("site-header");
  if (header?.dataset.revealOnScroll === "true") {
    const updateVisibility = () => {
      header.classList.toggle("-translate-y-full", window.scrollY < window.innerHeight - 4);
    };
    updateVisibility();
    onScroll(updateVisibility);
  }
</script>
