---
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import ShipSpares from "../components/ShipSpares.astro";
import WarehousingSpotlight from "../components/WarehousingSpotlight.astro";
import Industries from "../components/Industries.astro";
import Certifications from "../components/Certifications.astro";
import HowItWorks from "../components/HowItWorks.astro";
import TrustedBy from "../components/TrustedBy.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import BackgroundTransition from "../components/BackgroundTransition.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Outfit (headings/display) + Poppins (body) site-wide, independent of the logo -->
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Alpha Star Shipping</title>
	</head>
	<body>
		<!-- first, so window.__lenis exists before any other component's script (Header, BackgroundTransition) tries to use it -->
		<SmoothScroll />
		<Hero />
		<!-- fixed + hidden until the hero scrolls past, then reveals already pinned at top
		     (plain sticky would visibly slide up from the bottom as you approach it) -->
		<Header revealOnScroll />
		<About />
		<Services />
		<ShipSpares />
		<WarehousingSpotlight />
		<Industries />
		<Certifications />
		<HowItWorks />
		<TrustedBy />
		<Testimonials />
		<FAQ />
		<ContactCTA />
		<Footer />
		<ScrollAnimations />
		<BackgroundTransition />
	</body>
</html>
