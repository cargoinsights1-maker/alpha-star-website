---
// Contact Us page. Form posts to Web3Forms (static-friendly form backend —
// no server/adapter needed): every submission both emails the destination
// address below AND is stored in Web3Forms' dashboard, satisfying "send a
// mail" and "data to be collected" with one integration. Swap
// WEB3FORMS_ACCESS_KEY for a real key (free, instant, tied to the
// destination inbox) before this goes live — see commit message / handoff
// notes for the one-time setup step.
import Layout from "../layouts/Layout.astro";
import ServiceHero from "../components/ServiceHero.astro";

const WEB3FORMS_ACCESS_KEY = "4fa49f8f-9534-46a0-a0af-55f08edd1c73";

const serviceOptions = [
  "Air Freight",
  "Sea Freight",
  "Road Freight",
  "Warehousing & 3PL",
  "Multimodal Transport",
  "Customs Clearance",
  "Ship Spares Logistics",
  "Other",
];
---

<Layout title="Contact Us | Alpha Star Shipping" description="Get in touch with Alpha Star Shipping's team in Dubai for freight forwarding, customs clearance, and logistics solutions across the GCC and beyond.">
  <ServiceHero
    eyebrow="Get In Touch"
    title="Contact Us"
    intro="Tell us what you're moving and where. Our team replies with a tailored solution, usually within one business day."
    breadcrumb={[{ label: "Home", href: "/" }, { label: "Contact Us" }]}
    gradient="linear-gradient(135deg, #15205660, #0a0f2e)"
    ctaLabel="Call Us Now"
    ctaHref="tel:+97142699820"
  />

  <section class="relative overflow-hidden bg-white py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
        <!-- Contact info -->
        <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
          <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Alpha Star Shipping</p>
          <h2 class="mt-3 text-3xl leading-tight font-bold text-navy sm:text-4xl">We're Here to Move Your Cargo</h2>
          <p class="mt-5 max-w-md leading-relaxed text-navy/70">
            Whether it's a single urgent shipment or an ongoing supply chain, reach out directly or send us the details below and we'll get back to you with a plan.
          </p>

          <div class="mt-9 space-y-5">
            <a href="tel:+97142699820" class="group flex items-start gap-4">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-brand-red/10 text-brand-red transition-colors group-hover:bg-brand-red group-hover:text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-navy">Call Us</span>
                <span class="block text-sm text-navy/60 transition-colors group-hover:text-brand-red">+971 4 269 9820</span>
              </span>
            </a>

            <a href="mailto:mateen@alphastarshipping.com" class="group flex items-start gap-4">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-brand-red/10 text-brand-red transition-colors group-hover:bg-brand-red group-hover:text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 6-10 7L2 6" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-navy">Email Us</span>
                <span class="block text-sm text-navy/60 transition-colors group-hover:text-brand-red">mateen@alphastarshipping.com</span>
              </span>
            </a>

            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-brand-red/10 text-brand-red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-navy">Visit Us</span>
                <span class="block max-w-xs text-sm leading-relaxed text-navy/60">P.O. Box 29252, 128 Community, 9A Street, Warehouse No. 8, Al Khabaisi, Deira, Dubai, UAE</span>
              </span>
            </div>

            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-brand-red/10 text-brand-red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 6v6l4 2" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-navy">Office Hours</span>
                <span class="block text-sm text-navy/60">Sunday – Thursday, 9:00 AM – 6:00 PM (GST)</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Form card -->
        <div data-reveal class="relative translate-y-8 opacity-0 transition-all delay-150 duration-700 ease-out">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-brand-blue-light/15 blur-2xl"></div>

          <div class="relative rounded-3xl border border-slate-100 bg-white p-6 shadow-2xl shadow-brand-blue/10 sm:p-10">
            <form id="contact-form" class="space-y-5">
              <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="New Enquiry from Alpha Star Shipping Website" />
              <input type="hidden" name="from_name" value="Alpha Star Shipping — Contact Form" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-semibold text-navy">Full Name <span class="text-brand-red">*</span></label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="mb-1.5 block text-sm font-semibold text-navy">Email Address <span class="text-brand-red">*</span></label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                    placeholder="you@company.com"
                  />
                </div>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="phone" class="mb-1.5 block text-sm font-semibold text-navy">Phone Number</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                    placeholder="+971 ..."
                  />
                </div>
                <div>
                  <label for="company" class="mb-1.5 block text-sm font-semibold text-navy">Company</label>
                  <input
                    id="company"
                    name="company"
                    type="text"
                    class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                    placeholder="Company name"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="mb-1.5 block text-sm font-semibold text-navy">Service You're Interested In</label>
                <select
                  id="service"
                  name="service"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                >
                  <option value="">Select a service</option>
                  {serviceOptions.map((option) => <option value={option}>{option}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="mb-1.5 block text-sm font-semibold text-navy">Message <span class="text-brand-red">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="4"
                  class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-navy outline-none transition-colors focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20"
                  placeholder="Tell us about your shipment or query"
                ></textarea>
              </div>

              <p id="contact-form-error" class="hidden text-sm font-medium text-brand-red"></p>

              <button
                type="submit"
                class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-black/20 transition-shadow hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-60"
              >
                <span id="contact-form-submit-label">Send Message</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:translate-x-1">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </button>
            </form>

            <div id="contact-form-success" class="hidden flex-col items-center py-10 text-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <h3 class="mt-5 text-xl font-bold text-navy">Message Sent</h3>
              <p class="mt-2 max-w-sm text-sm leading-relaxed text-navy/60">Thank you for reaching out. A member of our team will get back to you shortly.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ accessKey: WEB3FORMS_ACCESS_KEY }}>
    const form = document.getElementById("contact-form");
    const successPanel = document.getElementById("contact-form-success");
    const errorMessage = document.getElementById("contact-form-error");
    const submitLabel = document.getElementById("contact-form-submit-label");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorMessage.classList.add("hidden");

      if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
        errorMessage.textContent = "Form is not yet configured to send. Please call or email us directly for now.";
        errorMessage.classList.remove("hidden");
        return;
      }

      const submitButton = form.querySelector("button[type=submit]");
      submitButton.disabled = true;
      submitLabel.textContent = "Sending...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await response.json();

        if (result.success) {
          form.classList.add("hidden");
          successPanel.classList.remove("hidden");
          successPanel.classList.add("flex");
        } else {
          throw new Error(result.message || "Submission failed");
        }
      } catch {
        errorMessage.textContent = "Something went wrong sending your message. Please try again or contact us directly.";
        errorMessage.classList.remove("hidden");
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = "Send Message";
      }
    });
  </script>
</Layout>
