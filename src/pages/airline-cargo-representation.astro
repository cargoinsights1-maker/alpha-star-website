---
// Standalone top-level nav page (not nested under Services), matching the
// 4 anchors already live in nav.ts's airlineCargoItems: #turkmenistan-airlines,
// #air-arabia, #cargo-sales-representation, #airline-cargo-enquiries.
// Content sourced from: the client's own catalogue (Turkmenistan Airlines CSA
// capability grid, page 11, "Air cargo and CSA capability") and the live
// alphastarshipping.com Air Freight page (CSA status for Air Arabia, AWB
// stock carriers, 90+ airline / 130+ destination network claim) — no section
// here is invented, everything traces back to one of those two sources.
import Layout from "../layouts/Layout.astro";
import ServiceHero from "../components/ServiceHero.astro";
import ServiceDifferentiators from "../components/ServiceDifferentiators.astro";
import PartnerLogos from "../components/PartnerLogos.astro";
import ContactCTA from "../components/ContactCTA.astro";

const icons = {
  hub: '<circle cx="12" cy="5" r="2" /><circle cx="5" cy="19" r="2" /><circle cx="19" cy="19" r="2" /><path d="M12 7v6M12 13l-5.5 4M12 13l5.5 4" />',
  route: '<path d="M4 18c4-10 12-10 16 0" /><circle cx="4" cy="18" r="1.5" /><circle cx="20" cy="18" r="1.5" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />',
  expand: '<path d="M4 4h6M4 4v6M4 4l7 7M20 20h-6M20 20v-6M20 20l-7-7" />',
  hazard: '<path d="M12 3l9 16H3L12 3Z" /><path d="M12 10v4M12 17h.01" />',
  globe: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 2.5 15.5 0 18M12 3c-2.5 2.5-2.5 15.5 0 18" />',
};

const turkmenistanCapabilities = [
  { label: "Capacity Access", description: "Direct airline coordination and commercial support.", icon: icons.hub },
  { label: "CIS Connectivity", description: "Turkmenistan and Central Asia routing expertise.", icon: icons.route },
  { label: "AOG and OBC", description: "Priority response for time-critical cargo.", icon: icons.clock },
  { label: "Charter Execution", description: "Aircraft sourcing, load planning and operations.", icon: icons.expand },
  { label: "DG Capability", description: "GCAA-approved dangerous goods handling.", icon: icons.hazard },
  { label: "Global Partner Reach", description: "Origin and destination coordination worldwide.", icon: icons.globe },
];

const airlinePartners = [
  { name: "Emirates SkyCargo", src: "/partners/emirates-skycargo.webp" },
  { name: "flydubai", src: "/partners/flydubai.webp" },
  { name: "Etihad Cargo", src: "/partners/etihad-cargo.webp" },
  { name: "Air Arabia", src: "/partners/air-arabia.webp" },
  { name: "Turkish Airlines", src: "/partners/turkish-airlines.webp" },
  { name: "Turkmenistan Airlines", src: "/partners/turkmenistan-airlines.webp" },
];
---

<Layout
  title="Airline Cargo Representation | Alpha Star Shipping"
  description="Alpha Star Shipping is the appointed Cargo Sales Agent for Turkmenistan Airlines and Air Arabia in the UAE, with Airway Bill stock held for Emirates, Etihad, flydubai, Turkish Airlines and Qatar Airways."
>
  <ServiceHero
    eyebrow="Airline Cargo Representation"
    title="Cargo Sales Agency and Airline Representation"
    intro="Appointed Cargo Sales Agent (CSA) for Turkmenistan Airlines and Air Arabia in the UAE, with direct Airway Bill stock and commercial access across more than 90 international airlines."
    breadcrumb={[{ label: "Home", href: "/" }, { label: "Airline Cargo Representation" }]}
    image="/services/air-freight-ground.webp"
    gradient="linear-gradient(135deg, #152056, #12557f)"
    ctaLabel="Send an Enquiry"
  />

  <section id="turkmenistan-airlines" class="relative overflow-hidden bg-white py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(rgba(0,156,60,0.12) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="pointer-events-none absolute top-0 right-[-8%] h-[420px] w-[420px] rounded-full bg-[#009c3c]/10 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
          <p class="text-sm font-semibold tracking-widest text-[#009c3c] uppercase">Exclusive CSA Capability</p>
          <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">Turkmenistan Airlines Cargo Representation in the UAE</h2>
          <p class="mt-6 leading-relaxed text-navy/70">
            Alpha Star Shipping is the appointed Cargo Sales Agent (CSA) of Turkmenistan Airlines in the UAE. The CSA platform
            strengthens Alpha Star's access to capacity, commercial development and Central Asia connectivity, while the wider air
            freight team handles standard, urgent and charter movements alongside it.
          </p>
        </div>

        <div data-reveal class="relative translate-x-10 opacity-0 transition-all delay-150 duration-700 ease-out">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-[#009c3c]/15 blur-2xl"></div>
          <div class="flex aspect-[16/9] items-center justify-center rounded-3xl bg-white p-12 shadow-2xl shadow-[#009c3c]/15 ring-1 ring-[#009c3c]/10">
            <img src="/partners/turkmenistan-airlines.webp" alt="Turkmenistan Airlines" class="h-full w-full object-contain" />
          </div>
        </div>
      </div>

      <ServiceDifferentiators items={turkmenistanCapabilities} accentFrom="#009c3c" accentTo="#4ade80" />
    </div>
  </section>

  <section id="air-arabia" class="relative overflow-hidden bg-slate-50 py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.5]"
      style="background-image: radial-gradient(rgba(228,12,72,0.1) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="pointer-events-none absolute top-0 left-[-8%] h-[420px] w-[420px] rounded-full bg-[#e40c48]/10 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div data-reveal class="relative order-2 translate-x-10 opacity-0 transition-all duration-700 ease-out lg:order-1">
          <div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-[#e40c48]/15 blur-2xl"></div>
          <div class="flex aspect-[16/9] items-center justify-center rounded-3xl bg-white p-12 shadow-2xl shadow-[#e40c48]/15 ring-1 ring-[#e40c48]/10">
            <img src="/partners/air-arabia.webp" alt="Air Arabia" class="h-full w-full object-contain" />
          </div>
        </div>

        <div data-reveal class="order-1 translate-y-8 opacity-0 transition-all delay-150 duration-700 ease-out lg:order-2">
          <p class="text-sm font-semibold tracking-widest text-[#e40c48] uppercase">Cargo Sales Agent</p>
          <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">Air Arabia Cargo Representation</h2>
          <p class="mt-6 leading-relaxed text-navy/70">
            Alpha Star Shipping is the appointed Cargo Sales Agent for Air Arabia, supporting cargo bookings and commercial
            coordination across Air Arabia's network connecting the UAE to destinations throughout the Middle East, North Africa,
            Central Asia and the Indian Subcontinent.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div id="cargo-sales-representation">
    <section class="relative overflow-hidden bg-white pt-20 sm:pt-24">
      <div class="pointer-events-none absolute top-0 right-[-8%] h-[420px] w-[420px] rounded-full bg-brand-blue-light/10 blur-3xl"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
            <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Cargo Sales and Representation</p>
            <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">Commercial Access Across the Air Cargo Network</h2>
            <p class="mt-6 leading-relaxed text-navy/70">
              Beyond its CSA appointments, Alpha Star holds Airway Bill stock for Emirates SkyCargo, Etihad Cargo, flydubai,
              Turkish Airlines and Qatar Airways, with commercial access and operational execution across more than 90
              international airlines and 130 destinations worldwide.
            </p>
          </div>

          <div data-reveal class="translate-x-10 opacity-0 transition-all delay-150 duration-700 ease-out">
            <div class="grid grid-cols-2 gap-4 rounded-3xl border border-brand-blue/10 bg-white p-8 shadow-2xl shadow-brand-blue/10 sm:p-10">
              {
                [
                  { value: "90+", label: "International Airlines" },
                  { value: "130+", label: "Destinations Worldwide" },
                  { value: "5", label: "Airway Bill Stock Carriers" },
                  { value: "2", label: "Exclusive CSA Partnerships" },
                ].map((stat) => (
                  <div class="rounded-2xl bg-slate-50 p-5 text-center">
                    <p class="bg-gradient-to-br from-brand-blue to-brand-blue-light bg-clip-text text-4xl font-extrabold text-transparent sm:text-5xl">
                      {stat.value}
                    </p>
                    <p class="mt-2 text-xs leading-snug font-semibold tracking-wide text-navy/60 uppercase">{stat.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
    <PartnerLogos heading="Airlines We Work With" intro="Cargo sales agency, Airway Bill stock and commercial representation across major carriers." logos={airlinePartners} />
  </div>

  <section id="airline-cargo-enquiries" class="relative overflow-hidden bg-navy py-20 sm:py-24">
    <div class="pointer-events-none absolute top-0 right-[-10%] h-[460px] w-[460px] rounded-full bg-brand-blue-light/15 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="max-w-2xl translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Airline Cargo Enquiries</p>
        <h2 class="mt-4 text-3xl leading-tight font-bold text-white sm:text-4xl">Talk to Our Air Freight Team</h2>
        <p class="mt-6 leading-relaxed text-white/70">
          For CSA bookings, Airway Bill stock availability or general airline cargo enquiries, reach our air freight team directly.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="tel:+97142699820" class="flex items-center gap-2 text-sm font-semibold text-white transition-colors hover:text-brand-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-brand-red">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            +971 4 269 9820
          </a>
          <a href="mailto:mateen@alphastarshipping.com" class="flex items-center gap-2 text-sm font-semibold text-white transition-colors hover:text-brand-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-brand-red">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 6-10 7L2 6" />
            </svg>
            mateen@alphastarshipping.com
          </a>
        </div>

        <a
          href="/contact"
          class="group mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-red to-[#a3121c] px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-black/30 transition-shadow hover:shadow-xl"
        >
          Contact Us
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
