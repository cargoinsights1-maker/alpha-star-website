---

<Layout
  title="Insights | Alpha Star Shipping"
  description="Real cargo stories and case studies from Alpha Star Shipping — how we plan, coordinate and deliver freight, customs and specialist logistics movements across the GCC and beyond."
>
  <section class="relative overflow-hidden bg-white pt-28 pb-20 sm:pt-32 sm:pb-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs font-medium text-navy/50 sm:text-sm">
        <a href="/" class="transition-colors hover:text-brand-red">Home</a>
        <span class="text-navy/25">/</span>
        <span class="text-navy">Insights</span>
      </nav>

      <p class="mt-5 text-sm font-semibold tracking-widest text-brand-red uppercase">Insights</p>
      <h1 class="mt-3 text-4xl leading-[1.05] font-bold text-navy sm:text-5xl">Real Cargo Stories and Case Studies</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy/70">
        How Alpha Star plans, coordinates and delivers freight, customs and specialist logistics movements, drawn
        directly from real shipments and the partners who moved them with us.
      </p>
    </div>
  </section>

  <section id="real-cargo-stories" class="relative overflow-hidden bg-slate-50 py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.5]"
      style="background-image: radial-gradient(rgba(18,85,127,0.1) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Real Cargo Stories</p>
        <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">From Our Customers and Partners</h2>
      </div>

      <div class="mt-12 space-y-8">
        {
          realCargoStories.map((story, i) => (
            <article
              data-reveal
              style={`transition-delay: ${Math.min(i, 4) * 80}ms`}
              class="translate-y-8 overflow-hidden rounded-3xl border border-slate-100 bg-white p-6 opacity-0 shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-700 ease-out sm:p-8"
            >
              <div class="flex items-start gap-4">
                <span class="flex-none font-sans text-3xl font-black text-brand-red/80 sm:text-4xl">{story.number}</span>
                <div class="min-w-0">
                  <p class="text-xs font-semibold tracking-wide text-navy/50 uppercase">{story.category}</p>
                  <h3 class="mt-1 text-xl font-bold text-navy sm:text-2xl">{story.title}</h3>
                  <p class="mt-2 text-sm font-semibold text-brand-blue">{story.stats}</p>
                </div>
              </div>

              <div class="mt-6 grid gap-5 sm:grid-cols-3">
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Challenge</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.challenge}</p>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Our Approach</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.approach}</p>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Outcome</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.outcome}</p>
                </div>
              </div>

              {story.photos && (
                <div class="mt-6">
                  <div class={`grid gap-3 ${story.photos.length > 1 ? "sm:grid-cols-2" : ""}`}>
                    {story.photos.map((photo) => (
                      <img src={photo} alt="" class="aspect-[4/3] w-full rounded-2xl object-cover" />
                    ))}
                  </div>
                  {story.photoCaption && <p class="mt-2 text-xs text-navy/50 italic">{story.photoCaption}</p>}
                </div>
              )}

              {story.quote && (
                <div class="mt-6 rounded-xl border-l-4 border-brand-red bg-slate-50 p-4 sm:p-5">
                  <p class="text-xs font-bold tracking-wide text-brand-red uppercase">
                    {story.category.includes("Customer") ? "Customer Appreciation" : "Forwarding-Partner Appreciation"}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-navy italic sm:text-base">&ldquo;{story.quote.text}&rdquo;</p>
                  <p class="mt-3 text-sm font-bold text-navy">{story.quote.name}</p>
                  <p class="text-xs text-navy/60">{story.quote.role}</p>
                  <p class="text-xs text-navy/40">{story.quote.date}</p>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="case-studies" class="relative overflow-hidden bg-white py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(rgba(18,85,127,0.1) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Case Studies</p>
        <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">Operations, Documented</h2>
      </div>

      <div class="mt-12 space-y-6">
        {
          caseStudies.map((story, i) => (
            <article
              data-reveal
              style={`transition-delay: ${Math.min(i, 4) * 80}ms`}
              class="translate-y-8 overflow-hidden rounded-2xl border border-slate-100 bg-white p-6 opacity-0 shadow-sm transition-all duration-700 ease-out sm:p-7"
            >
              <div class="flex items-start gap-4">
                <span class="flex-none font-sans text-2xl font-black text-navy/20 sm:text-3xl">{story.number}</span>
                <div class="min-w-0">
                  <p class="text-xs font-semibold tracking-wide text-navy/50 uppercase">{story.category}</p>
                  <h3 class="mt-1 text-lg font-bold text-navy sm:text-xl">{story.title}</h3>
                  <p class="mt-2 text-sm font-semibold text-brand-blue">{story.stats}</p>
                </div>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Challenge</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.challenge}</p>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Our Approach</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.approach}</p>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-wide text-navy uppercase">Outcome</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-navy/70">{story.outcome}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
