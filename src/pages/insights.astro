---
// "Insights" page — matches nav.ts's /insights#... anchors. Only 2 of the 6
// nav sub-sections have real content so far (Real Cargo Stories, Case
// Studies) — built per the "don't get ahead" rule; Market/Operational
// Updates, Customer Advisories, Logistics Guides and News aren't stubbed
// with invented copy.
//
// Source: client's case-study PDF (20 items, "Publication pending
// approval"). Items 1-15 are used here — they have no outstanding
// redaction/approval notes. Items 16-20 (Gabon power plant, MV TEN MARS,
// Legero Middle East Doha, GFS LETO Valencia, A330 engine Miami) were
// explicitly excluded per the user's own decision: each carries a
// "Production note" requiring photo redaction (clear third-party branding/
// people/labels) that can't be done reliably here, plus two cases where
// naming permission is explicitly not yet confirmed.
//
// Photos: matched against the real media handover folder
// (05_Project_Photos_and_Video/Case_Study_Media), which numbers its files
// by case number. Of the 6 cases with a matching photo on hand (5, 6, 7, 9,
// 10, 14), 3 (9 girder loading, 10 module offloading, 14 dry dock handling)
// showed the same kind of unredacted third-party branding/identifiable
// faces that got 16-20 excluded, so the same standard was applied: those 3
// stay text-only, and only the already-clean/pre-redacted photos (5, 6,
// both of 7) are used.
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";

interface Quote {
  text: string;
  name: string;
  role: string;
  date: string;
}

interface CaseStudy {
  number: string;
  category: string;
  title: string;
  stats: string;
  challenge: string;
  approach: string;
  outcome: string;
  quote?: Quote;
  photos?: string[];
  photoCaption?: string;
}

