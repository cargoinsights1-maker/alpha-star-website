---
import Layout from "../../../layouts/Layout.astro";
import ServiceHero from "../../../components/ServiceHero.astro";
import ServiceDifferentiators from "../../../components/ServiceDifferentiators.astro";
import ServiceSubItems from "../../../components/ServiceSubItems.astro";
import ContactCTA from "../../../components/ContactCTA.astro";
import { airFreight } from "../../../data/services";
import { aog } from "../../../data/subServicePages";

// ServiceSubItems' own href fallback (`#${id}`) is only correct when the
// component renders on the sub-items' own parent page, where that's a real
// same-page anchor. Reused here on a different page, siblings without a
// dedicated page of their own need the full path back to where that anchor
// actually lives.
const siblings = airFreight.subServices
  .filter((item) => item.id !== aog.slug)
  .map((item) => ({ ...item, href: item.href ?? `${aog.parentHref}#${item.id}` }));
---

<Layout title={aog.metaTitle} description={aog.metaDescription}>
  <ServiceHero
    eyebrow={aog.parentLabel}
    title={aog.label}
    intro={aog.heroIntro}
    breadcrumb={[{ label: "Home", href: "/" }, { label: "Services" }, { label: aog.parentLabel, href: aog.parentHref }, { label: aog.label }]}
    image={airFreight.heroImage}
    gradient={airFreight.heroGradient}
  />

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(rgba(18,85,127,0.12) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="max-w-3xl translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <p class="text-sm font-semibold tracking-widest text-brand-red uppercase">Why Alpha Star</p>
        <h2 class="mt-4 text-3xl leading-tight font-bold text-navy sm:text-4xl">{aog.overviewHeading}</h2>
        {aog.overview.map((paragraph) => <p class="mt-6 leading-relaxed text-navy/70">{paragraph}</p>)}
      </div>

      <div class="mt-14 lg:mt-16">
        <ServiceDifferentiators items={airFreight.differentiators} />
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-slate-50 py-20 sm:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.5]"
      style="background-image: radial-gradient(rgba(18,85,127,0.1) 1px, transparent 1px); background-size: 22px 22px;"
    >
    </div>
    <div class="pointer-events-none absolute top-0 right-[-8%] h-[420px] w-[420px] rounded-full bg-brand-blue-light/15 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal class="max-w-2xl translate-y-8 opacity-0 transition-all duration-700 ease-out">
        <h2 class="text-3xl font-extrabold tracking-wide text-navy uppercase sm:text-4xl">More {aog.parentLabel} Services</h2>
      </div>
      <ServiceSubItems items={siblings} />
    </div>
  </section>

  <ContactCTA />
</Layout>
